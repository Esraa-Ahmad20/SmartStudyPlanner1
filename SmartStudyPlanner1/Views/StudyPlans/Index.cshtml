@model IEnumerable<SmartStudyPlanner1.Models.StudyPlan>
@{
    ViewData["Title"] = "Study Plans";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1>📅 Study Plans</h1>
        <p style="color:var(--muted);">Your personalized study schedules</p>
    </div>
    <a href="/StudyPlans/Create" class="btn btn-primary">+ Create Plan</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card text-center" style="padding:48px;">
        <div style="font-size:3rem;margin-bottom:12px;">📅</div>
        <h4>No study plans yet</h4>
        <a href="/StudyPlans/Create" class="btn btn-primary mt-3">Create Your First Plan</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var plan in Model)
        {
            var tasks = plan.StudyTasks ?? new List<SmartStudyPlanner1.Models.StudyTask>();

            var total = tasks.Count;
            var done = tasks.Count(t => t.IsCompleted);
            var pct = total > 0 ? (int)(done * 100.0 / total) : 0;

            <div class="col-md-4">
                <div class="card">

                    <h5 style="font-weight:700;margin-bottom:12px;">
                        @plan.PlanName
                    </h5>

                    <div style="color:var(--muted);font-size:0.83rem;margin-bottom:6px;">
                        📅 @plan.StartDate?.ToString("MMM dd") → @plan.EndDate?.ToString("MMM dd, yyyy")
                    </div>

                    <div style="color:var(--muted);font-size:0.83rem;margin-bottom:16px;">
                        ⏰ @plan.DailyStudyHours h/day · @total tasks
                    </div>

                    <div style="margin-bottom:6px;display:flex;justify-content:space-between;font-size:0.82rem;">
                        <span>Progress</span>
                        <span style="color:var(--primary);">@pct%</span>
                    </div>

                    <div class="progress" style="margin-bottom:16px;">
                        <div class="progress-bar" style="width:@pct%"></div>
                    </div>

                    <div style="display:flex;gap:8px;">
                        <a href="/StudyPlans/Details/@plan.PlanId"
                           class="btn btn-primary"
                           style="padding:6px 14px;font-size:0.82rem;">
                            View
                        </a>

                        <a href="/StudyPlans/Edit/@plan.PlanId"
                           class="btn btn-secondary"
                           style="padding:6px 14px;font-size:0.82rem;">
                            ✏️ Edit
                        </a>

                        <a href="/StudyPlans/Delete/@plan.PlanId"
                           class="btn btn-danger"
                           style="font-size:0.82rem;"
                           onclick="return confirm('Delete this plan?')">
                            Delete
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
}
