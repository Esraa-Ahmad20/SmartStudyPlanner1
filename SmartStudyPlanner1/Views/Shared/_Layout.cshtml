<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Study Planner</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary: #6366f1;
            --secondary: #8b5cf6;
            --accent: #06b6d4;
            --bg: #0f172a;
            --surface: #1e293b;
            --surface2: #334155;
            --text: #f1f5f9;
            --muted: #94a3b8;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Space Grotesk', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }
        .sidebar {
            width: 260px;
            background: var(--surface);
            height: 100vh;
            position: fixed;
            top: 0; left: 0;
            border-right: 1px solid var(--surface2);
            display: flex;
            flex-direction: column;
            z-index: 100;
        }
        .sidebar-logo {
            padding: 24px 20px;
            border-bottom: 1px solid var(--surface2);
        }
        .sidebar-logo h2 {
            font-size: 1.2rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .sidebar-nav { padding: 16px 12px; flex: 1; }
        .nav-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            color: var(--muted);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
            margin-bottom: 4px;
        }
        .nav-item a:hover, .nav-item a.active {
            background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(139,92,246,0.1));
            color: var(--text);
        }
        .nav-item a i { width: 20px; text-align: center; font-size: 1rem; }
        .main-content {
            margin-left: 260px;
            padding: 32px;
            min-height: 100vh;
        }
        .page-header {
            margin-bottom: 28px;
        }
        .page-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--surface2);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            border-radius: 10px;
            padding: 10px 24px;
            font-weight: 600;
            color: white;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .btn-primary:hover { opacity: 0.9; color: white; }
        .btn-danger {
            background: var(--danger);
            border: none;
            border-radius: 8px;
            padding: 7px 16px;
            font-size: 0.85rem;
            color: white;
        }
        .btn-success {
            background: var(--success);
            border: none;
            border-radius: 8px;
            padding: 7px 16px;
            font-size: 0.85rem;
            color: white;
        }
        .form-control, .form-select {
            background: var(--surface2);
            border: 1px solid #475569;
            color: var(--text);
            border-radius: 10px;
            padding: 10px 14px;
        }
        .form-control:focus, .form-select:focus {
            background: var(--surface2);
            color: var(--text);
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99,102,241,0.2);
        }
        .form-label { color: var(--muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; }
        .badge-diff-1 { background: rgba(16,185,129,0.2); color: #10b981; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }
        .badge-diff-2 { background: rgba(245,158,11,0.2); color: #f59e0b; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }
        .badge-diff-3 { background: rgba(239,68,68,0.2); color: #ef4444; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }
        .progress { background: var(--surface2); border-radius: 50px; height: 8px; }
        .progress-bar { background: linear-gradient(90deg, var(--primary), var(--accent)); }
        .table { color: var(--text); }
        .table thead th { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; border-color: var(--surface2); }
        .table td { border-color: var(--surface2); vertical-align: middle; }
        .sidebar-footer { padding: 16px 12px; border-top: 1px solid var(--surface2); }
    </style>
</head>
<body>
    @{
        var userId = Context.Session.GetInt32("UserId");
        var userName = Context.Session.GetString("UserName");
    }
    @if (userId != null)
    {
        <div class="sidebar">
            <div class="sidebar-logo">
                <h2>📚 Smart Study</h2>
                <p style="color:var(--muted);font-size:0.8rem;margin-top:4px;">@userName</p>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-item"><a href="/Dashboard"><i class="fas fa-home"></i> Dashboard</a></div>
                <div class="nav-item"><a href="/Subjects"><i class="fas fa-book"></i> Subjects</a></div>
                <div class="nav-item"><a href="/StudyPlans"><i class="fas fa-calendar-alt"></i> Study Plans</a></div>
                <div class="nav-item"><a href="/StudyTasks/TodayTasks"><i class="fas fa-tasks"></i> Today's Tasks</a></div>
                <div class="nav-item"><a href="/Progress"><i class="fas fa-chart-bar"></i> Progress</a></div>
                <div class="nav-item"><a href="/Pomodoro"><i class="fas fa-clock"></i> Pomodoro Timer</a></div>
                <div class="nav-item">
                    <a href="/Ai">
                        <i class="fas fa-robot"></i> AI Assistant
                    </a>
                </div>
            </nav>
            <div class="sidebar-footer">
                <a href="/Account/Logout" style="color:var(--danger);text-decoration:none;font-size:0.9rem;display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:8px;"
                   onmouseover="this.style.background='rgba(239,68,68,0.1)'" onmouseout="this.style.background='transparent'">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    }

    <div class="@(userId != null ? "main-content" : "")">
        @RenderBody()
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>