@{
    ViewData["Title"] = "Dashboard";
    var subjects = ViewBag.Subjects as List<SmartStudyPlanner1.Models.Subject>;
    var todayTasks = ViewBag.TodayTasks as List<SmartStudyPlanner1.Models.StudyTask>;
    var quote = ViewBag.Quote as SmartStudyPlanner1.Models.MotivationQuote;
}

<div class="page-header">
    <h1>👋 Welcome, @ViewBag.UserName</h1>
    <p style="color:var(--muted);">Here's your study overview for today</p>
</div>

@if (quote != null)
{
    <div class="card" style="color:white; background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(6,182,212,0.1));border-color:rgba(99,102,241,0.3);margin-bottom:24px;">
 
        <p style="font-size:1.1rem;font-style:italic;margin:0;">"@quote.QuoteText"</p>
        <span style="color:var(--muted);font-size:0.8rem;">— @quote.Category</span>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div style="font-size:2rem;margin-bottom:8px;">📖</div>
            <div style="font-size:2rem;font-weight:700;color:var(--primary);">@(subjects?.Count ?? 0)</div>
            <div style="color:var(--muted);font-size:0.85rem;">Total Subjects</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div style="font-size:2rem;margin-bottom:8px;">✅</div>
            <div style="font-size:2rem;font-weight:700;color:var(--success);">@(todayTasks?.Count(t => t.IsCompleted) ?? 0)</div>
            <div style="color:var(--muted);font-size:0.85rem;">Done Today</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div style="font-size:2rem;margin-bottom:8px;">📋</div>
            <div style="font-size:2rem;font-weight:700;color:var(--warning);">@(todayTasks?.Count(t => !t.IsCompleted) ?? 0)</div>
            <div style="color:var(--muted);font-size:0.85rem;">Pending Today</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div style="font-size:2rem;margin-bottom:8px;">🎯</div>
            <div style="font-size:2rem;font-weight:700;color:var(--accent);">
                @(todayTasks != null && todayTasks.Any() ? (int)(todayTasks.Count(t => t.IsCompleted) * 100.0 / todayTasks.Count) : 0)%
            </div>
            <div style="color:var(--muted);font-size:0.85rem;">Today's Progress</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card">
            <h5 style="color:white;margin-bottom:16px;">📅 Today's Tasks</h5>
            @if (todayTasks == null || !todayTasks.Any())
            {
                <p style="color:white;text-align:center;padding:20px;">No tasks scheduled for today 🎉</p>
            }
            else
            {
                foreach (var task in todayTasks.Take(5))
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--surface2);">
                        <span style="font-size:1.2rem;">@(task.IsCompleted ? "✅" : "⏳")</span>
                        <div style="flex:1;">
                            <div style=" color:white;font-weight:600;font-size:0.9rem;">@task.Chapter?.ChapterTitle</div>
                            <div style="color:white;font-size:0.8rem;">@task.Chapter?.Subject?.SubjectName</div>
                        </div>
                    </div>
                }
                <div class="mt-3">
                    <a href="/StudyTasks/TodayTasks" style="color:var(--primary);font-size:0.85rem;">View all tasks →</a>
                </div>
            }
        </div>
    </div>
    <div class="col-md-5">
        <div class="card">
            <h5 style=" color:white; margin-bottom:16px;">📚 My Subjects</h5>
            @if (subjects == null || !subjects.Any())
            {
                <p style="color:white;text-align:center;">No subjects yet. <a href="/Subjects/Create" style="color:var(--primary);">Add one!</a></p>
            }
            else
            {
                foreach (var s in subjects.Take(5))
                {
                    var daysLeft = (s.ExamDate - DateTime.Today).Days;
                    <div style="margin-bottom:14px;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                            <span style="font-size:0.88rem;font-weight:600;color:white">@s.SubjectName</span>
                            <span style="font-size:0.78rem;color:@(daysLeft < 7 ? "var(--danger)" : "var(--muted)");">@daysLeft days</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar" style="width:50%"></div>
                        </div>
                    </div>
                }
                <a href="/Subjects" style="color:var(--primary);font-size:0.85rem;">View all →</a>
            }
        </div>
    </div>
</div>