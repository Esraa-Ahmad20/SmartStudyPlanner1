@{
    ViewData["Title"] = "Pomodoro Timer";
}

<div class="page-header">
    <h1>⏱️ Pomodoro Timer</h1>
    <p style="color:var(--muted);">Stay focused with 25-minute study sessions</p>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card text-center" style="padding:40px;">
            <div id="timer-display" style="font-size:5rem;font-weight:700;color:var(--primary);font-variant-numeric:tabular-nums;margin-bottom:24px;">25:00</div>
            <div style="display:flex;gap:12px;justify-content:center;margin-bottom:24px;">
                <button id="startBtn" onclick="startTimer()" class="btn btn-primary" style="padding:12px 28px;">▶ Start</button>
                <button onclick="pauseTimer()" class="btn" style="background:var(--surface2);color:var(--text);border-radius:10px;padding:12px 28px;">⏸ Pause</button>
                <button onclick="resetTimer()" class="btn btn-danger" style="padding:12px 28px;">↺ Reset</button>
            </div>
            <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
                <button onclick="setMode(25,'🎯 Focus')" class="btn" style="background:rgba(99,102,241,0.2);color:var(--primary);border-radius:8px;padding:7px 16px;font-size:0.83rem;">25m Focus</button>
                <button onclick="setMode(5,'☕ Break')" class="btn" style="background:rgba(16,185,129,0.2);color:var(--success);border-radius:8px;padding:7px 16px;font-size:0.83rem;">5m Break</button>
                <button onclick="setMode(15,'🧘 Long Break')" class="btn" style="background:rgba(6,182,212,0.2);color:var(--accent);border-radius:8px;padding:7px 16px;font-size:0.83rem;">15m Break</button>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <h5 style="margin-bottom:16px;">📊 Log This Session</h5>
            <div class="mb-3">
                <label class="form-label">Subject</label>
                <select id="subjectSelect" class="form-select">
                    @foreach (var s in ViewBag.Subjects as List<SmartStudyPlanner1.Models.Subject>)
                    {
                        <option value="@s.SubjectId">@s.SubjectName</option>
                    }
                </select>
            </div>
            <button onclick="saveSession()" class="btn btn-primary">💾 Save Session</button>
            <div id="saveMsg" style="display:none;color:var(--success);margin-top:12px;">✅ Session saved!</div>
        </div>
        <div class="card">
            <h5 style="margin-bottom:8px;">💡 Pomodoro Technique</h5>
            <ul style="color:var(--muted);font-size:0.85rem;padding-left:18px;line-height:1.9;">
                <li>Focus for 25 minutes</li>
                <li>Take a 5-minute break</li>
                <li>After 4 sessions, take a 15-minute break</li>
                <li>Repeat to maximize productivity</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let timeLeft = 25 * 60;
        let timerInterval = null;
        let isRunning = false;
        let currentMode = 25;

        function formatTime(s) {
            const m = Math.floor(s / 60);
            const sec = s % 60;
            return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
        }

        function updateDisplay() {
            document.getElementById('timer-display').textContent = formatTime(timeLeft);
        }

        function startTimer() {
            if (isRunning) return;
            isRunning = true;
            timerInterval = setInterval(() => {
                timeLeft--;
                updateDisplay();
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    isRunning = false;
                    document.getElementById('timer-display').style.color = 'var(--success)';
                    alert('🎉 Session complete! Take a break!');
                }
            }, 1000);
        }

        function pauseTimer() {
            clearInterval(timerInterval);
            isRunning = false;
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            timeLeft = currentMode * 60;
            document.getElementById('timer-display').style.color = 'var(--primary)';
            updateDisplay();
        }

        function setMode(mins, label) {
            currentMode = mins;
            timeLeft = mins * 60;
            clearInterval(timerInterval);
            isRunning = false;
            document.getElementById('timer-display').style.color = 'var(--primary)';
            updateDisplay();
        }

        async function saveSession() {
            const subjectId = document.getElementById('subjectSelect').value;
            const spentMins = currentMode - Math.floor(timeLeft / 60);
            const duration = spentMins > 0 ? spentMins : currentMode;

            await fetch('/Pomodoro/Save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ subjectId: parseInt(subjectId), durationMinutes: duration })
            });

            document.getElementById('saveMsg').style.display = 'block';
            setTimeout(() => document.getElementById('saveMsg').style.display = 'none', 3000);
        }
    </script>
}