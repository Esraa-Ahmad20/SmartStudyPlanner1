@model IEnumerable<SmartStudyPlanner1.Models.Resource>
@{
    ViewData["Title"] = "Resources";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>📎 Resources</h1>
    <a href="/Subjects/Details/@ViewBag.SubjectId" class="btn" style="background:var(--surface2);color:var(--text);border-radius:10px;padding:10px 24px;">← Back</a>
</div>

<div class="card" style="max-width:500px;margin-bottom:24px;">
    <h5 style="margin-bottom:16px;color:white">Add Resource</h5>
    <form method="post" action="/Resources/Create">
        <input type="hidden" name="SubjectId" value="@ViewBag.SubjectId" />
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Link (URL)</label>
            <input type="url" name="Link" class="form-control" placeholder="https://..." />
        </div>
        <button type="submit" class="btn btn-primary">Add Resource</button>
    </form>
</div>

<div class="card">
    <h5 style="margin-bottom:16px;">All Resources</h5>
    @if (!Model.Any())
    {
        <p style="color:var(--muted);text-align:center;padding:20px;">No resources yet.</p>
    }
    else
    {
        @foreach (var r in Model)
        {
            <div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--surface2);">
                <span>🔗</span>
                <div style="flex:1;">
                    <div style="font-weight:600;font-size:0.9rem;">@r.Title</div>
                    @if (!string.IsNullOrEmpty(r.Link))
                    {
                        <a href="@r.Link" target="_blank" style="color:var(--primary);font-size:0.8rem;">@r.Link</a>
                    }
                </div>
                <div style="display:flex;gap:6px;">
                    <a href="/Resources/Edit/@r.ResourceId" class="btn" style="font-size:0.78rem;padding:4px 10px;background:var(--surface2);color:var(--text);border-radius:8px;">Edit</a>
                    <a href="/Resources/Delete/@r.ResourceId" class="btn btn-danger" style="font-size:0.78rem;padding:4px 10px;" onclick="return confirm('Delete?')">Delete</a>
                </div>
            </div>
        }
    }
</div>