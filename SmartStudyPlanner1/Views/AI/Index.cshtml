@{
    ViewData["Title"] = "AI Assistant";
}

<div class="page-header">
    <h1>🤖 AI Study Assistant</h1>
    <p style="color:var(--muted);">Ask anything about your studies</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card" style="padding:0;overflow:hidden;">
            <div id="chatBox" style="
                min-height:420px;
                max-height:420px;
                overflow-y:auto;
                padding:24px;
                display:flex;
                flex-direction:column;
                gap:16px;">
                <div style="text-align:center;color:var(--muted);margin-top:80px;">
                    <div style="font-size:3rem;margin-bottom:12px;">🤖</div>
                    <p>Hi! I'm your AI study assistant.<br>Ask me anything about your subjects!</p>
                </div>
            </div>
            <div style="
                border-top:1px solid var(--surface2);
                padding:16px;
                display:flex;
                gap:10px;
                background:var(--surface);">
                <input id="question"
                       class="form-control"
                       placeholder="Ask something..."
                       onkeypress="if(event.key==='Enter') askAI()"
                       style="flex:1;" />
                <button onclick="askAI()" class="btn btn-primary" style="padding:10px 20px;">
                    Send ➤
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <h6 style="color:var(--muted);margin-bottom:12px;">💡 Quick Questions</h6>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <button onclick="ask('How can I study more effectively?')"
                        class="btn" style="background:var(--surface2);color:var(--text);border-radius:10px;padding:8px 14px;font-size:0.82rem;text-align:left;">
                    📚 How to study effectively?
                </button>
                <button onclick="ask('Give me tips to memorize information faster')"
                        class="btn" style="background:var(--surface2);color:var(--text);border-radius:10px;padding:8px 14px;font-size:0.82rem;text-align:left;">
                    🧠 Tips to memorize faster
                </button>
                <button onclick="ask('How to manage my time during exam season?')"
                        class="btn" style="background:var(--surface2);color:var(--text);border-radius:10px;padding:8px 14px;font-size:0.82rem;text-align:left;">
                    ⏰ Time management tips
                </button>
                <button onclick="ask('How to reduce stress before exams?')"
                        class="btn" style="background:var(--surface2);color:var(--text);border-radius:10px;padding:8px 14px;font-size:0.82rem;text-align:left;">
                    😌 Reduce exam stress
                </button>
                <button onclick="ask('What is the best way to take notes?')"
                        class="btn" style="background:var(--surface2);color:var(--text);border-radius:10px;padding:8px 14px;font-size:0.82rem;text-align:left;">
                    📝 Best note-taking methods
                </button>
            </div>
        </div>

        <div class="card">
            <h6 style="color:var(--muted);margin-bottom:8px;">ℹ️ About AI Assistant</h6>
            <p style="color:var(--muted);font-size:0.82rem;line-height:1.6;">
                Powered by GPT-3.5. Ask anything related to your studies, exam preparation, or learning strategies.
            </p>
        </div>
    </div>
</div>

<script>
    function addMessage(text, isUser) {
        const chatBox = document.getElementById('chatBox');

        if (chatBox.querySelector('.text-center')) {
            chatBox.innerHTML = '';
        }

        const msg = document.createElement('div');
        msg.style.cssText = `
            display:flex;
            gap:10px;
            align-items:flex-start;
            ${isUser ? 'flex-direction:row-reverse;' : ''}
        `;

        const avatar = document.createElement('div');
        avatar.style.cssText = `
            width:36px;height:36px;border-radius:50%;
            display:flex;align-items:center;justify-content:center;
            font-size:1.1rem;flex-shrink:0;
            background:${isUser ? 'linear-gradient(135deg,#6366f1,#8b5cf6)' : 'rgba(6,182,212,0.2)'};
        `;
        avatar.textContent = isUser ? '👤' : '🤖';

        const bubble = document.createElement('div');
        bubble.style.cssText = `
            max-width:80%;
            padding:12px 16px;
            border-radius:${isUser ? '16px 4px 16px 16px' : '4px 16px 16px 16px'};
            background:${isUser ? 'linear-gradient(135deg,rgba(99,102,241,0.3),rgba(139,92,246,0.2))' : 'var(--surface2)'};
            font-size:0.88rem;
            line-height:1.6;
            white-space:pre-wrap;
        `;
        bubble.textContent = text;

        msg.appendChild(avatar);
        msg.appendChild(bubble);
        chatBox.appendChild(msg);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function addLoading() {
        const chatBox = document.getElementById('chatBox');
        const loading = document.createElement('div');
        loading.id = 'loading-msg';
        loading.style.cssText = 'display:flex;gap:10px;align-items:center;';
        loading.innerHTML = `
            <div style="width:36px;height:36px;border-radius:50%;background:rgba(6,182,212,0.2);display:flex;align-items:center;justify-content:center;font-size:1.1rem;">🤖</div>
            <div style="background:var(--surface2);padding:12px 16px;border-radius:4px 16px 16px 16px;color:var(--muted);font-size:0.85rem;">
                Thinking<span id="dots">.</span>
            </div>
        `;
        chatBox.appendChild(loading);
        chatBox.scrollTop = chatBox.scrollHeight;

        let d = 0;
        window._dotsInterval = setInterval(() => {
            d = (d + 1) % 4;
            const el = document.getElementById('dots');
            if (el) el.textContent = '.'.repeat(d + 1);
        }, 400);
    }

    function removeLoading() {
        clearInterval(window._dotsInterval);
        const el = document.getElementById('loading-msg');
        if (el) el.remove();
    }

    function ask(question) {
        document.getElementById('question').value = question;
        askAI();
    }

    function askAI() {
        const input = document.getElementById('question');
        const question = input.value.trim();
        if (!question) return;

        addMessage(question, true);
        input.value = '';
        addLoading();

        fetch('/Ai/Task', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question })
        })
        .then(r => r.json())
        .then(data => {
            removeLoading();
            addMessage(data.answer, false);
        })
        .catch(() => {
            removeLoading();
            addMessage('Sorry, something went wrong. Please try again.', false);
        });
    }
</script>
